<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Solo laboratorio: permite retirada del admin de prueba por ADB coordinada. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <application android:testOnly="true">
        <activity android:name=".prototype.PrototipoBloqueoActivity"
            android:exported="true" android:label="Prototipo reversible (DEBUG)" android:lockTaskMode="normal">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver android:name=".prototype.RollbackPrototipo" android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
